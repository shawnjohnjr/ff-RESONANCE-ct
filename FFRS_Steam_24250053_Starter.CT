-- Official item labels from installed Steam build 24250053, en / zh-Hant.
-- Two untranslated zh-Hant placeholders use explicitly marked provisional translations.
-- Only item-name strings are included; no descriptions, dialogue, or game assets.
local itemNames = {
 [1]={en="Potion",zh="治療劑",kind=1},
 [2]={en="Hi-Potion",zh="高級治療劑",kind=1},
 [3]={en="Ether",zh="乙太",kind=1},
 [4]={en="Phoenix Down",zh="鳳凰尾巴",kind=1},
 [7]={en="Antidote Herb",zh="解毒草",kind=1},
 [8]={en="Remedy",zh="萬能藥",kind=1},
 [9]={en="Knife of Poison",zh="毒匕首",kind=1},
 [10]={en="Eye Drops",zh="眼藥",kind=1},
 [11]={en="Smelling Salts",zh="清醒藥",kind=1},
 [12]={en="Echo Herb",zh="山彥草",kind=1},
 [13]={en="Unicorn Horn",zh="獨角獸之角",kind=1},
 [14]={en="X-Potion",zh="至高治療劑",kind=1},
 [16]={en="Gold Needle",zh="金針",kind=1},
 [17]={en="Herb of Awakening",zh="提神劑",kind=1},
 [18]={en="X-Ether",zh="超級乙太",kind=1},
 [19]={en="Healing Spring",zh="回復之泉",kind=1},
