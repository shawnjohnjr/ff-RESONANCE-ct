local function itemDisplayName(id,kind)
 local n=itemNames[id]
 if n and n.kind==kind then return n.en.." / "..n.zh end
 return "Unknown item / 未翻譯道具"
end

-- UE DataTable rows: sparse TMap&lt;FName, uint8*&gt; with allocation-bit checks.
local function tableRows(s,o,expected)
 assert(s.cname(o)=='DataTable' and s.oname(readPointer(o+0x28))==expected,'Data table changed; retry')
 local m=o+0x30;local p=readPointer(m);local n=readInteger(m+8);local cap=readInteger(m+12)
 assert(n and cap and n&gt;=0 and n&lt;=cap and cap&lt;=10000,'Invalid table size')
 assert(n==0 or (p and p&gt;65536),'Invalid row data')
 local bits=readPointer(m+0x20);if not bits or bits==0 then bits=m+0x10 end
 local bitCount=readInteger(m+0x28);assert(bitCount and bitCount&gt;=n and bitCount&lt;=10000,'Invalid allocation flags')
 local out={}
 for i=0,n-1 do
  local b=assert(readInteger(bits+math.floor(i/32)*4),'Unreadable allocation flags')
  if (b &amp; (1 &lt;&lt; (i%32)))~=0 then
   local a=p+i*24;local row=readPointer(a+8)
   assert(row and row&gt;65536,'Invalid row pointer')
   out[#out+1]={key=s.name(readInteger(a)),p=row}
  end
 end
 return out
end
local function findTable(s,row)
 local found
 for _,t in ipairs(s.tables) do
  if t.row==row then
   assert(s.at(t.index)==t.object and s.oname(t.object)==t.name,'Table cache expired; reopen CT')
   assert(not found,'Multiple matching tables; stop')
   found=t.object
  end
 end
 return assert(found,'Required table not loaded: '..row)
end
local function inventoryChoices(s)
 local catalog={}
 for _,kind in ipairs({'CONSUMABLES_ITEM_DATA','EQUIPMENT_ITEM_DATA'}) do
  for _,r in ipairs(tableRows(s,findTable(s,kind),kind)) do
   local id=readInteger(r.p+8);local typ=readBytes(r.p+0x70,1)
   if id and id&gt;0 and (typ==1 or typ==3) and r.key~='?' then
    assert(not catalog[id],'Duplicate item ID')
    catalog[id]={name=itemDisplayName(id,typ),kind=typ}
   end
  end
 end
 assert(s.count&lt;=5000,'Inventory too large')
 local out,seen={},{}
 for i=0,s.count-1 do
  local a=s.inventory+i*8;local id=readInteger(a);local qty=readInteger(a+4)
  assert(id and qty and qty&gt;=0,'Invalid inventory entry')
  local item=catalog[id]
  if item and qty&gt;0 then
   assert(not seen[id],'Duplicate owned item ID');seen[id]=true
   out[#out+1]={id=id,quantity=qty,address=a,name=item.name,kind=item.kind}
  end
 end
 table.sort(out,function(a,b)return a.id&lt;b.id end)
 return out
end
local function setItem(s,item,target)
 assert(target and target==math.floor(target) and target&gt;=1 and target&lt;=99,'Quantity must be 1..99')
 local now=connect()
 assert(now.save==s.save and now.manager==s.manager and now.inventory==s.inventory and now.count==s.count,'Inventory changed; reopen the picker')
 assert(readInteger(item.address)==item.id and readInteger(item.address+4)==item.quantity,'Item changed during input; retry')
 if target==item.quantity then return end
 assert(writeInteger(item.address+4,target),'Item write failed')
 if readInteger(item.address+4)~=target then
  writeInteger(item.address+4,item.quantity)
  error('Item read-back failed; attempted to restore original quantity')
 end
end
local function arrayAt(a,max)
 local p=readPointer(a);local n=readInteger(a+8);local cap=readInteger(a+12)
 assert(n and cap and n&gt;=0 and n&lt;=cap and cap&lt;=max,'Invalid array')
 assert(n==0 or (p and p&gt;65536),'Invalid array pointer')
 return p,n
end
local function partyPlan(s)
 local party,n=arrayAt(s.save+0x90,8);assert(n&gt;0,'No party members')
 local units,un=arrayAt(s.save+0x60,64)
 local byId={}
 for i=0,un-1 do local a=units+i*0xA0;local id=readInteger(a);assert(id and not byId[id],'Invalid unit ID');byId[id]=a end
 local definitions={}
 for _,r in ipairs(tableRows(s,findTable(s,'UNIT_PARAMETER'),'UNIT_PARAMETER')) do definitions[readInteger(r.p+8)]={curve=readInteger(r.p+0x3C),name=r.key} end
 local curves={}
 for _,r in ipairs(tableRows(s,findTable(s,'UNIT_LEVEL_PARAMETER_LIST'),'UNIT_LEVEL_PARAMETER_LIST')) do curves[readInteger(r.p+8)]=readPointer(r.p+0x10) end
 local out,seen={},{}
 for i=0,n-1 do
  local id=readInteger(party+i*4)
  assert(id and id&gt;=1001 and id&lt;=1008 and not seen[id],'Unexpected party member');seen[id]=true
  local a=assert(byId[id],'Party member missing from save');local def=assert(definitions[id],'Missing unit definition')
  local levels={}
  for _,r in ipairs(tableRows(s,assert(curves[def.curve],'Missing curve'),'UNIT_LEVEL_PARAMETER')) do
   local lv=readInteger(r.p+8);local xp=readInteger(r.p+12)
   if lv and lv&gt;=1 and lv&lt;=99 then assert(not levels[lv] and xp and xp&gt;=0,'Invalid level curve');levels[lv]=xp end
  end
  local sum=0;for lv=1,99 do sum=sum+assert(levels[lv],'Incomplete level curve') end
  assert(sum&gt;0 and sum&lt;=2147483647,'Invalid level-99 EXP')
  local old=readInteger(a+4);assert(old and old&gt;=0,'Invalid current EXP')
  out[#out+1]={id=id,address=a,experience=old,target=sum,name=def.name,partyIndex=i}
 end
 return out,party,n,units
end
local function checkCode(a,bytes)
 local actual=readBytes(a,#bytes,true);assert(actual,'Game function unavailable')
 for i=1,#bytes do assert(actual[i]==bytes[i],'Game function mismatch; stop') end
end
local function checkLevelFunctions(s)
 checkCode(s.base+0x523BC00,{0x48,0x8B,0xC4,0x56,0x48,0x81,0xEC,0xD0,0,0,0})
 checkCode(s.base+0x524B3A0,{0x48,0x89,0x5C,0x24,0x18,0x48,0x89,0x74,0x24,0x20,0x57,0x48,0x81,0xEC,0xD0,1,0,0})
end
local function setParty99(s,plan,party,n,units)
 checkLevelFunctions(s)
 -- Preflight all targets with the game's own EXP-to-level calculation.
 for _,u in ipairs(plan) do
  assert(executeCodeEx(0,5000,s.base+0x523BC00,u.id,u.target)==99,'Game rejected level-99 threshold')
 end
 local report={}
 for _,u in ipairs(plan) do
  local now=connect();local pp,pn=arrayAt(now.save+0x90,8);local up=arrayAt(now.save+0x60,64)
  assert(now.save==s.save and now.manager==s.manager and pp==party and pn==n and up==units,'Party/save changed; stop')
  for _,member in ipairs(plan) do assert(readInteger(party+member.partyIndex*4)==member.id,'Party changed; stop') end
  assert(readInteger(u.address)==u.id and readInteger(u.address+4)==u.experience,'Character EXP changed; retry')
  if u.experience&lt;u.target then
   -- Native SetPlayableUnitExperience(UnitId, EXP, isMaxStatusSet=false):
   -- updates save EXP and refreshes the live character parameters/skills.
   executeCodeEx(0,10000,s.base+0x524B3A0,u.id,u.target,0)
   assert(readInteger(u.address+4)==u.target,'EXP update did not finish; stop and check game')
  end
  local xp=readInteger(u.address+4)
  local lv=executeCodeEx(0,5000,s.base+0x523BC00,u.id,xp)
  assert(lv==99,'Level verification failed; stop and check game')
  report[#report+1]=string.format('%s（ID %d）：Lv.%d／EXP %d',u.name,u.id,lv,xp)
 end
 return report
end

local s=connect()
local pack={
 {10197,1,1,1},{10297,1,1,2},{10397,1,1,3},{10496,1,1,4},
 {10597,1,1,5},{10696,1,1,8},{10797,1,1,6},{10897,1,1,7},
 {11397,8,2,9},{11097,8,2,10},{11597,8,2,11},
 {12101,8,3,0},{12095,8,3,0},{12096,8,3,0},{12103,8,3,0}
}
local catalog={}
for _,r in ipairs(tableRows(s,findTable(s,'EQUIPMENT_ITEM_DATA'),'EQUIPMENT_ITEM_DATA')) do catalog[readInteger(r.p+8)]=r.p end
checkCode(s.base+0x5107500,{0x48,0x89,0x5C,0x24,0x08,0x57,0x48,0x83,0xEC,0x20,0x8B,0xDA,0x8B,0xF9})
local function inventoryMap(state)
 assert(state.count&lt;=5000,'Inventory too large')
 local map={}
 for i=0,state.count-1 do
  local p=state.inventory+i*8;local id=readInteger(p);local qty=readInteger(p+4)
  assert(id and qty and qty&gt;=0 and qty&lt;=2147483647 and map[id]==nil,'Invalid/duplicate inventory record')
  map[id]=qty
 end
 return map
end
local expected=inventoryMap(s)
local lines={'8 種角色武器各至少 1 件；3 種防具、4 種飾品各至少 8 件。','只補足背包數量，不自動裝備，不解鎖角色。',''}
for _,v in ipairs(pack) do
 local row=assert(catalog[v[1]],'Equipment missing from this build')
 assert(readBytes(row+0x70,1)==3 and readBytes(row+0x80,1)==v[3] and readBytes(row+0x81,1)==v[4],'Equipment category mismatch')
 assert(itemNames[v[1]] and itemNames[v[1]].kind==3,'Equipment label missing')
 lines[#lines+1]=itemDisplayName(v[1],3)..' × '..v[2]
end
local answer=inputQuery('全角色終盤裝備包',table.concat(lines,'\n')..'\n\n請停在選單並備份存檔。輸入 YES 執行，取消則不修改：','')
if not answer then return end
assert(answer:upper()=='YES','Enter YES or cancel')
local added=0
for _,v in ipairs(pack) do
 local current=connect()
 assert(current.save==s.save and current.manager==s.manager,'Save changed; stopped (earlier grants may remain)')
 local actual=inventoryMap(current)
 for id,qty in pairs(expected) do assert(actual[id]==qty,'Inventory changed; stopped (earlier grants may remain)') end
 for id,qty in pairs(actual) do assert(expected[id]==qty,'Inventory changed; stopped (earlier grants may remain)') end
 local old=actual[v[1]] or 0
 if old&lt;v[2] then
  executeCodeEx(0,10000,s.base+0x5107500,v[1],v[2]-old)
  local after=connect();assert(after.save==s.save,'Save changed after grant; stop')
  expected[v[1]]=v[2]
  actual=inventoryMap(after)
  for id,qty in pairs(expected) do assert(actual[id]==qty,'Grant read-back failed; stop and check inventory') end
  for id,qty in pairs(actual) do assert(expected[id]==qty,'Unexpected inventory change; stop and check inventory') end
  added=added+v[2]-old
 end
end
showMessage('終盤裝備包完成，本次新增 '..added..' 件。請重開裝備選單，自行選擇各角色裝備；確認後另存新欄位。')

{$asm}
[DISABLE]
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>7</ID>
      <Description>"07 自動普通攻擊（勾選啟用／取消停止）"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- FFRS retail Steam build 24250053. Read-only lookup, no injected game calls.
-- SDK reference: PolarWizard/final-fantasy-resonance-fix (MIT).
local function connect()
 local pid=assert(getProcessIDFromProcessName('FFRS-Win64-Shipping.exe'),'Resonance is not running')
 if getOpenedProcessID()~=pid then openProcess(pid) end
 local base=assert(getAddressSafe('FFRS-Win64-Shipping.exe'),'Game module unavailable')
 local pe=base+readInteger(base+0x3c)
 assert(readInteger(pe+8)==0x6A586B2F and readInteger(pe+0x50)==503013376,'Unsupported game build; stop and revalidate')
 local pool=base+0x9CA1280
 local names={}
 local blocks=readInteger(pool+8)
 assert(blocks and blocks&gt;=0 and blocks&lt;8192,'Invalid name pool')
 local function name(id)
  if not id or id&lt;0 then return '?' end
  if names[id] then return names[id] end
  local block=math.floor(id/65536);local off=(id%65536)*2
  if block&gt;blocks then return '?' end
  local p=readPointer(pool+0x10+block*8);if not p or p&lt;65536 then return '?' end
  local h=readSmallInteger(p+off);if not h then return '?' end
  if h&lt;0 then h=h+65536 end
  local len=math.floor(h/64)
  if len&gt;1023 then return '?' end
  local s
  if h%2==1 then s=readString(p+off+2,len*2,true)
  else local b=readBytes(p+off+2,len,true);s=b and string.char(table.unpack(b)) end
  names[id]=s or '?';return names[id]
 end
 assert(name(0)=='None','Name pool does not match this game')
 local function oname(o) return o and o&gt;65536 and name(readInteger(o+0x18)) or '?' end
 local classes={}
 local function cname(o)
  local c=o and readPointer(o+0x10)
  if not c or c&lt;65536 then return '?' end
  if not classes[c] then classes[c]=oname(c) end
  return classes[c]
 end
 local world=readPointer(base+0x9AA0540)
 assert(world and world&gt;65536 and cname(world)=='World','Wait for a loaded world')
 local gi=readPointer(world+0x228)
 assert(gi and gi&gt;65536,'Wait for the game instance')
 local g=base+0x9D84DD0;local count=readInteger(g+0x14);local chunks=readPointer(g)
 assert(count and count&gt;0 and count&lt;2000000 and chunks and chunks&gt;65536,'Invalid object array')
 local chunkCount=readInteger(g+0x1c)
 assert(chunkCount and chunkCount&gt;0 and chunkCount&lt;=math.ceil(2000000/65536),'Invalid object chunks')
 local function at(i)
  if i&lt;0 or i&gt;=count then return nil end
  local ch=readPointer(chunks+math.floor(i/65536)*8)
  return ch and ch&gt;65536 and readPointer(ch+(i%65536)*24) or nil
 end
 local function ismanager(o)
  if not o or o&lt;65536 then return false end
  local flags=readInteger(o+8)
  return flags and (flags &amp; 0x10)==0 and cname(o)=='CPP_MuchaSaveDataManager' and readPointer(o+0x20)==gi
 end
 local cached=_G.FFRS_CT_SESSION
 local manager,index
 local tables={}
 if cached and cached.pid==pid and cached.base==base and at(cached.index)==cached.manager and ismanager(cached.manager) and cached.tables then
  manager,index=cached.manager,cached.index
  tables=cached.tables
 else
  for i=0,count-1 do
   local o=at(i)
   if o and o&gt;65536 and cname(o)=='DataTable' then
    local row=readPointer(o+0x28)
    local rn=oname(row)
    if rn=='CONSUMABLES_ITEM_DATA' or rn=='EQUIPMENT_ITEM_DATA' or rn=='UNIT_PARAMETER' or rn=='UNIT_LEVEL_PARAMETER_LIST' then
     tables[#tables+1]={object=o,index=i,row=rn,name=oname(o)}
    end
   end
   if ismanager(o) then assert(not manager,'Multiple active save managers; stop');manager,index=o,i end
  end
 end
 assert(manager,'Active save manager not found; load a save first')
 local save=readPointer(manager+0x60)
 assert(save and save&gt;65536 and cname(save)=='CPP_MuchaGameSaveData','Active save data unavailable')
 local flags=readInteger(save+8);assert(flags and (flags &amp; 0x10)==0,'Default object is not a save')
 local gil=readInteger(save+0x28)
 assert(gil and gil&gt;=0 and gil&lt;=2147483647,'Invalid money value')
 local inv=readPointer(save+0xA8);local n=readInteger(save+0xB0);local cap=readInteger(save+0xB4)
 assert(n and cap and n&gt;=0 and n&lt;=cap and cap&lt;=100000,'Invalid inventory array')
 assert(n==0 or (inv and inv&gt;65536),'Invalid inventory pointer')
 _G.FFRS_CT_SESSION={pid=pid,base=base,manager=manager,index=index,tables=tables}
 return {at=at,oname=oname,cname=cname,name=name,tables=tables,pid=pid,base=base,manager=manager,save=save,gil=gil,inventory=inv,count=n,capacity=cap}
end

